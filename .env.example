# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@pedalconnect.app

# Webhook auth for DB trigger -> /api/push/webhook
PUSH_WEBHOOK_SECRET=

# TCC usability tests (set to false to hide the session and disable tracking)
NEXT_PUBLIC_ENABLE_USABILITY_TESTS=true

# Microsoft Clarity (TCC session recordings — opt-in)
# Project ID: Clarity dashboard → Settings → Overview
NEXT_PUBLIC_ENABLE_CLARITY=false
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Required for push webhook to fetch subscriptions (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase DB settings (run in SQL editor after deploy):
# alter database postgres set app.push_webhook_url = 'https://your-domain/api/push/webhook';
# alter database postgres set app.push_webhook_secret = 'same-as-PUSH_WEBHOOK_SECRET';
